rootFrom = (start) ->
  root = path.resolve(start)
  while !fs.existsSync(path.join(root, 'logos.supervisor.json'))
    parent = path.dirname(root)
    if root == parent
      throw new Error('logos.supervisor.json not found')
    root = parent
  fs.realpathSync root

main = (argv, context) ->
  `var child`
  `var connected`
  `var n`
  _a = undefined
  if argv == undefined
    argv = process.argv.slice(2)
  if context == undefined
    context = {}
  await undefined if false
  args = __spreadArray([], __read(argv), false)
  root = (if (_a = context.root) != null and _a != undefined then _a else process.cwd())
  i = args.indexOf('--root')
  if i != -1
    if !args[i + 1]
      throw new Error('--root requires a path')
    root = args[i + 1]
    args.splice i, 2
  _b = __read(args, 2)
  _c = _b[0]
  command = (if _c == undefined then 'help' else _c)
  target = _b[1]
  if command == 'help' or command == '--help'
    console.log 'logos supervisor run|start|stop|restart|status|pid|logs|shutdown|validate|systemd [service] [--root workspace]'
    return 0
  if args.length > 2
    throw new Error('Unexpected arguments')
  root = rootFrom(root)
  p = paths(root)
  if command == 'validate'
    c = configuration(root)
    console.log JSON.stringify(
      valid: true
      services: c.order)
    return 0
  if command == 'systemd'

    q = (value) ->
      '"' + value.replaceAll('%', '%%').replaceAll('\\', '\\\\').replaceAll('"', '\"').replaceAll('$', '$$') + '"'

    console.log '[Unit]\nDescription=Logos workspace supervisor\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=simple\nWorkingDirectory='.concat(q(root), '\nExecStart=').concat(q(process.execPath), ' ').concat(q(path.join(__dirname, 'systemd-entry.cjs')), ' --root ').concat(q(root), '\nRestart=on-failure\nRestartSec=2\nKillMode=control-group\nTimeoutStopSec=180\nUMask=0077\n\n[Install]\nWantedBy=multi-user.target')
    return 0
  if command == '--serve'
    if process.env.LOGOS_SUPERVISOR_LOCK != p.lock
      throw new Error('Use run to acquire the supervisor lock')
    daemon_1 = new Supervisor(root)
    await daemon_1.listen()

    close = ->
      daemon_1.close().catch (e) ->
        console.error e.message
        process.exitCode = 1
        return

    process.once 'SIGTERM', close
    process.once 'SIGINT', close
    return 0
  if command == 'run'
    configuration root
    # flock holds an OS lock across exec, released on process death, no stale-PID guessing.
    child_1 = spawn('flock', [
      '--nonblock'
      '--no-fork'
      p.lock
      process.execPath
      __filename
      '--serve'
      '--root'
      root
    ],
      stdio: 'inherit'
      env: __assign(__assign({}, process.env), LOGOS_SUPERVISOR_LOCK: p.lock))

    term = ->
      child_1.kill 'SIGTERM'

    int = ->
      child_1.kill 'SIGINT'

    process.once 'SIGTERM', term
    process.once 'SIGINT', int
    try
      return await(new Promise((resolve, reject) ->
        child_1.once 'error', reject
        child_1.once 'exit', (code, signal) ->
          resolve (if code != null and code != undefined then code else (if signal then 1 else 0))
        return
))
    catch __caught
      throw __caught
    finally
      process.removeListener 'SIGTERM', term
      process.removeListener 'SIGINT', int
  if command == 'pid'
    status = await(request(root, 'status'))
    service = status.services.find((s) ->
      s.name == target
    )
    if !service
      throw new Error('Unknown service: '.concat(target))
    if !service.pid
      throw new Error('Service not running: '.concat(target))
    console.log service.pid
    return 0
  if command == 'start'
    configuration root
    try
      await request(root, 'status')
    catch e
      if ![
          'ENOENT'
          'ECONNREFUSED'
        ].includes(e.code)
        throw e
      child = spawn(process.execPath, [
        __filename
        'run'
        '--root'
        root
      ],
        detached: true
        stdio: 'ignore')
      child.unref()
      connected = false
      n = 0
      while n < 400
        await sleep(100)
        try
          await request(root, 'status')
          connected = true
          break
        catch err
          if ![
              'ENOENT'
              'ECONNREFUSED'
            ].includes(err.code)
            throw err
        n++
      if !connected
        throw new Error('Supervisor did not start; run in foreground for diagnostics')
  result = await(request(root, (if command == 'start' and !target then 'status' else command), target))
  console.log (if typeof result == 'string' then result else JSON.stringify(result, null, 2))
  0

'use strict'
__assign = this and @__assign or ->
  __assign = Object.assign or (t) ->
    s = undefined
    i = 1
    n = arguments.length
    while i < n
      s = arguments[i]
      for p of s
        if Object::hasOwnProperty.call(s, p)
          t[p] = s[p]
      i++
    t
  __assign.apply this, arguments
__read = this and @__read or (o, n) ->
  m = typeof Symbol == 'function' and o[Symbol.iterator]
  if !m
    return o
  i = m.call(o)
  r = undefined
  ar = []
  e = undefined
  try
    while (n == undefined or n-- > 0) and !(r = i.next()).done
      ar.push r.value
  catch error
    e = error: error
  finally
    try
      if r and !r.done and (m = i['return'])
        m.call i
    catch __caught
      throw __caught
    finally
      if e
        throw e.error
  ar
__spreadArray = this and @__spreadArray or (to, from, pack) ->
  if pack or arguments.length == 2
    i = 0
    l = from.length
    ar = undefined
    while i < l
      if ar or !(i of from)
        if !ar
          ar = Array::slice.call(from, 0, i)
        ar[i] = from[i]
      i++
  to.concat ar or Array::slice.call(from)
fs = require('node:fs')
path = require('node:path')
spawn = require('node:child_process').spawn
_a = require('./common.cjs')
paths = _a.paths
configuration = _a.configuration
sleep = _a.sleep
request = _a.request
Supervisor = require('./index.cjs').Supervisor
module.exports =
  main: main
  rootFrom: rootFrom
if require.main == module
  main().then ((code) ->
    process.exitCode = code
    return
  ), (e) ->
    console.error '[supervisor] '.concat(e.message)
    process.exitCode = 1
    return
