atomic = (file, value) ->
  tmp = ''.concat(file, '.').concat(process.pid, '.').concat(crypto.randomUUID(), '.tmp')
  fd = undefined
  renamed = false
  try
    fd = fs.openSync(tmp, 'wx', 384)
    fs.writeFileSync fd, JSON.stringify(value)
    fs.fsyncSync fd
    fs.closeSync fd
    fd = `undefined`
    fs.renameSync tmp, file
    renamed = true
    dir = fs.openSync(path.dirname(file), 'r')
    try
      fs.fsyncSync dir
    catch __caught
      throw __caught
    finally
      fs.closeSync dir
  catch __caught
    throw __caught
  finally
    if fd != `undefined`
      try
        fs.closeSync fd
      catch _a

        ### preserve the original failure ###

    if !renamed
      try
        fs.unlinkSync tmp
      catch _b

        ### preserve the original failure ###

  return

read = (file, fallback) ->
  try
    return JSON.parse(fs.readFileSync(file, 'utf8'))
  catch e
    if `e.code == 'ENOENT'`
      return fallback
    throw new Error('Invalid state '.concat(file, ': ').concat(e.message))
  return

paths = (root) ->
  root = fs.realpathSync(root)
  dir = path.join(root, '.logos', 'supervisor')
  fs.mkdirSync dir,
    recursive: true
    mode: 448
  stat = fs.lstatSync(dir)
  if !stat.isDirectory() or stat.uid != process.getuid() or stat.mode & 63
    throw new Error('Supervisor directory must be private and owned by this user')
  socket = path.join(dir, 'control.sock')
  if Buffer.byteLength(socket) > 103
    throw new Error('Workspace path too long for supervisor socket')
  {
    root: root
    dir: dir
    socket: socket
    lock: path.join(dir, 'owner.lock')
    state: path.join(dir, 'intent.json')
  }

identity = (pid) ->
  try
    s = fs.readFileSync('/proc/'.concat(pid, '/stat'), 'utf8')
    fields = s.slice(s.lastIndexOf(')') + 2).split(' ')
    if fields[0] == 'Z'
      return null
    return {
      pid: pid
      birth: fields[19]
      boot: fs.readFileSync('/proc/sys/kernel/random/boot_id', 'utf8').trim()
    }
  catch e
    if [
        'ENOENT'
        'ESRCH'
      ].includes(e.code)
      return null
    throw e
  return

alive = (id) ->
  now = id and identity(id.pid)
  ! !now and now.birth == id.birth and now.boot == id.boot

conflictingProcess = (service) ->
  e_1 = undefined
  _a = undefined
  _b = undefined
  if service.command != 'node' or !service.args.length
    return null
  script = path.resolve(service.cwd, service.args[0])
  try
    _c = __values(fs.readdirSync('/proc').filter((p) ->
      /^\d+$/.test p
    ).map(Number))
    _d = _c.next()
    while !_d.done
      pid = _d.value
      if pid == process.pid
        _d = _c.next()
