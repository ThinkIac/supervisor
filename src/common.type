configuration = (root) ->
  e_3 = undefined
  _a = undefined
  _b = undefined
  _c = undefined
  _d = undefined
  _e = undefined
  _f = undefined
  _g = undefined
  _h = undefined
  _j = undefined
  raw = read(path.join(root, 'logos.supervisor.json'))

  visit = (name) ->
    if !services[name]
      throw new Error('Unknown dependency: '.concat(name))
    if visiting.has(name)
      throw new Error('Service dependency cycle: '.concat(name))
    if visited.has(name)
      return
    visiting.add name
    services[name].dependsOn.forEach visit
