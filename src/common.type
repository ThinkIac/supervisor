fs = require('node:fs')
path = require('node:path')
net = require('node:net')
crypto = require('node:crypto')

sleep = (ms) ->
  new Promise((r) ->
    setTimeout r, ms
)

module.exports =
  atomic: atomic
  read: read
  paths: paths
  identity: identity
  alive: alive
  sleep: sleep
  policy: policy
  configuration: configuration
  request: request
  waitForReady: waitForReady
  conflictingProcess: conflictingProcess
