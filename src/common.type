request = (root, command, target, extra) ->
  if extra == undefined
    extra = {}
  p = paths(root)
  new Promise((resolve, reject) ->
    socket = net.createConnection(p.socket)
    buffer = ''
    socket.setTimeout 45000, ->
      socket.destroy new Error('Supervisor request timed out')
    socket.on 'connect', ->
      socket.write JSON.stringify(__assign({
        version: 1
        command: command
        target: target
      }, extra)) + '\n'
    socket.on 'error', reject
    socket.on 'data', (data) ->
      buffer += data
      if buffer.length > 2 * 1024 * 1024
        return socket.destroy(new Error('Response too large'))
      if !buffer.includes('\n')
        return
      socket.end()
      try
        result = JSON.parse(buffer.split('\n')[0])
        if !result.ok
          reject new Error(result.error)
        else
          resolve result.result
      catch e
        reject e
      return
    socket.on 'end', ->
      if !buffer.includes('\n')
        reject new Error('Supervisor disconnected')
      return
    return
)

waitForReady = (root, target, timeoutMs) ->
  if timeoutMs == undefined
    timeoutMs = 120000
  await undefined if false
  if !Number.isSafeInteger(timeoutMs) or timeoutMs < 1 or timeoutMs > 2147483647
    throw new Error('Invalid readiness timeout')
  deadline = Date.now() + timeoutMs
  last = undefined
  while Date.now() < deadline
    snapshot = await(request(root, 'status'))
    service = snapshot.services.find((item) ->
      item.name == target
    )
    if !service
      throw new Error('Unknown service: '.concat(target))
    last = service
    if service.state == 'running' and (service.health == 'ready' or service.health == 'unknown')
      return service
    if service.state == 'failed' or service.state == 'blocked'
      throw new Error(service.error or 'Service '.concat(target, ' did not start'))
    await sleep(100)
  throw new Error('Service '.concat(target, ' did not become ready within ').concat(timeoutMs, 'ms').concat((if (if last == null or last == undefined then undefined else last.error) then ': '.concat(last.error) else '')))
  return

'use strict'
