        argv = fs.readFileSync('/proc/'.concat(pid, '/cmdline'), 'utf8').split('\u0000').filter(Boolean)
        # PM2 changes argv[0] to its process title; compare that title too.
        if cwd == service.cwd and (argv.some(((arg) ->
            arg == script or arg == service.args[0]
          )) or (if (_b = argv[0]) == null or _b == undefined then undefined else _b.includes('('.concat(script, ')'))))
          return pid
      catch e
        if ![
            'ENOENT'
            'ESRCH'
            'EACCES'
          ].includes(e.code)
          throw e
      _d = _c.next()
  catch e_1_1
    e_1 = error: e_1_1
  finally
    try
      if _d and !_d.done and (_a = _c.return)
        _a.call _c
    catch __caught
      throw __caught
    finally
      if e_1
        throw e_1.error
  null

policy = (raw) ->
  e_2 = undefined
  _a = undefined
  if raw == undefined
    raw = {}
  p = __assign({
    restart: 'always'
    maxRestarts: 10
    windowMs: 60000
    minUptimeMs: 30000
    delayMs: 500
    maxDelayMs: 30000
    stopTimeoutMs: 10000
    bootTimeoutMs: 120000
    heartbeatMs: 0
  }, raw)
  if ![
      'always'
