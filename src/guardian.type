send = (value) ->
  if !process.connected
    return
  if value.op == 'log'
    if pendingLogs >= 8
      return
    # fixed memory bound when the daemon cannot drain output
    pendingLogs++
    process.send value, ->
      pendingLogs--
      return
  else
    process.send value, ->
  return

signal = (value) ->
  if (if child == null or child == undefined then undefined else child.pid)
    try
      process.kill -child.pid, value
    catch e
      if `e.code != 'ESRCH'`
        send
          op: 'diagnostic'
          error: e.message
  return

finish = (code, sig) ->
  clearTimeout timer
  signal 'SIGKILL'
  # descendants must not survive even a clean leader exit
  send
    op: 'exit'
    code: code
    signal: sig
  if record
    try
      fs.unlinkSync record
    catch _a
  process.exit 0
  return

stop = ->
  if stopping
    return
  `stopping = true`
  if !child
    return finish(null, 'SIGTERM')
  signal 'SIGTERM'
  `timer = setTimeout(function () {
  return signal('SIGKILL');
}, config.policy.stopTimeoutMs)`
  return

'use strict'
__assign = this and @__assign or ->
  __assign = Object.assign or (t) ->
    s = undefined
    i = 1
    n = arguments.length
    while i < n
      s = arguments[i]
      for p of s
        if Object::hasOwnProperty.call(s, p)
          t[p] = s[p]
      i++
    t
  __assign.apply this, arguments
# This process owns one process group. IPC loss always tears that group down.
spawn = require('node:child_process').spawn
fs = require('node:fs')
_a = require('./common.cjs')
atomic = _a.atomic
identity = _a.identity
child = undefined
stopping = false
timer = undefined
record = undefined
config = undefined
pendingLogs = 0
process.on 'disconnect', stop
process.on 'SIGTERM', stop
process.on 'SIGINT', stop
process.on 'message', (msg) ->
  if msg.op == 'stop'
    return stop()
  if msg.op != 'start' or config or stopping
    return
  config = msg.service
  record = msg.record
  atomic record, guardian: identity(process.pid)
  child = spawn((if config.command == 'node' then process.execPath else config.command), config.args,
    cwd: config.cwd
    env: __assign(__assign(__assign({}, process.env), config.env),
      LOGOS_SUPERVISOR_ROOT: msg.root
      LOGOS_SUPERVISOR_SERVICE: msg.name)
    detached: true
    stdio: [
      'ignore'
      'pipe'
      'pipe'
      'ipc'
    ])
  child.once 'spawn', ->
    atomic record,
      guardian: identity(process.pid)
      child: identity(child.pid)
    send
      op: 'spawn'
      pid: child.pid
    return
  child.stdout.on 'data', (d) ->
    send
      op: 'log'
      stream: 'stdout'
      text: d.toString().slice(0, 32768)
  child.stderr.on 'data', (d) ->
    send
      op: 'log'
      stream: 'stderr'
      text: d.toString().slice(0, 32768)
  child.on 'message', (m) ->
    if (if m == null or m == undefined then undefined else m.type) == 'logos:ready' or (if m == null or m == undefined then undefined else m.type) == 'logos:heartbeat'
      send op: m.type
    return
  child.once 'error', (e) ->
    send
      op: 'diagnostic'
      error: e.message
    finish 1, null
    return
  child.once 'exit', finish
  return
